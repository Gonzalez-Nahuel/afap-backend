// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum EditionStatus {
  DRAFT
  REGISTRATION
  ACTIVE
  FINISHED
}

enum EventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  FOUL
  POINT
}

enum CertStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefereeRole {
  MAIN
  LINE_1
  LINE_2
  FOURTH_OFFICIAL
  VAR
  ASSISTANT_VAR
}

enum StaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  PHYSICAL_TRAINER
  MEDICAL_STAFF
  TEAM_MANAGER
}

enum CompetitionRole {
  OWNER
  ADMINISTRATOR
  MODERATOR
}

enum EditionRole {
  ADMINISTRATOR
  REFEREE_MAIN
  REFEREE_LINE
  REFEREE_VAR
  FIELD_DELEGATE
  MEDICAL_DELEGATE
}

enum TeamRole {
  OWNER
  MANAGER
  PLAYER
}

enum MemberStatus {
  ACTIVE
  PENDING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AchievementType {
  CHAMPION
  RUNNER_UP
  THIRD_PLACE
  PARTICIPANT
}

model User {
  id            String     @id @default(uuid())
  username          String
  email         String  @unique
  password  String
  emailVerified Boolean @default(false)
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  persons Person[]
  session Session[]
  verificationToken VerificationToken[]
}

model VerificationToken {
  id String @id @default(uuid())
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId String
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash, id])
}

model Session {
  id String @id @default(uuid())
  userId String
  hashRefresh String @unique
  userAgent String
  ipAddress String
  isRevoked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, hashRefresh])
}

model Person {
  id        String    @id @default(uuid())
  firstName String
  lastName  String

  email     String?
  phone     String?
  birthDate DateTime?

  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  competitionMembers CompetitionMember[]
  editionMembers     EditionMember[]
  invitations        Invitation[]

  teamMembers         TeamMember[]
  createdConvocations TeamConvocation[]

  convocationMembers TeamConvocationMember[]

  editionTeamPlayers EditionTeamPlayer[]
  editionTeamStaffs  EditionTeamStaff[]

  matchReferees MatchReferee[]

  matchEvents        MatchEvent[]
  createdMatchEvents MatchEvent[] @relation("MatchEventCreatedBy")

  certifications OfficialCertification[]
  editionTeams   EditionTeam[]

  @@index([email])
  @@index([userId])
}

model Sport {
  id   String    @id @default(uuid())
  name String
  slug String @unique

  competitions Competition[]
}

model Competition {
  id          String     @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  city        String?

  sportId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sport Sport @relation(fields: [sportId], references: [id])

  members  CompetitionMember[]
  editions Edition[]

  invitations Invitation[] @relation("CompetitionInvitations")
}

model CompetitionMember {
  id String @id @default(uuid())

  competitionId String
  personId      String

  role   CompetitionRole
  status MemberStatus    @default(ACTIVE)

  createdAt DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([competitionId, personId, role])
}

model Invitation {
  id String @id @default(uuid())

  personId String

  token String @unique

  competitionId String?
  editionId     String?

  role String

  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id])

  competition Competition? @relation("CompetitionInvitations", fields: [competitionId], references: [id])

  edition Edition? @relation("EditionInvitations", fields: [editionId], references: [id])
}

model Edition {
  id String @id @default(uuid())

  competitionId String

  name String
  slug String @unique

  number Int
  year   Int?

  startDate DateTime
  endDate   DateTime?

  status EditionStatus @default(DRAFT)

  isOfficial Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  members EditionMember[]

  invitations Invitation[] @relation("EditionInvitations")

  teams   EditionTeam[]
  rounds  Round[]
  matches Match[]

  certifications   OfficialCertification[]
  teamAchievements TeamAchievement[]
}

model EditionMember {
  id String @id @default(uuid())

  editionId String
  personId  String

  role EditionRole

  status MemberStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([editionId, personId, role])
}

model Team {
  id String @id @default(uuid())

  name String

  logo String?

  enrollToken String @unique

  enrollConvocationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  achievements TeamAchievement[]
  members      TeamMember[]
  convocations TeamConvocation[]
  editionTeams EditionTeam[]
}

model TeamAchievement {
  id String @id @default(uuid())

  teamId    String
  editionId String

  achievement AchievementType

  createdAt DateTime?

  team Team @relation(fields: [teamId], references: [id])

  edition Edition @relation(fields: [editionId], references: [id])

  @@unique([teamId, editionId, achievement])
}

model TeamMember {
  id String @id @default(uuid())

  teamId   String
  personId String

  role TeamRole

  shirtNumber Int?
  position    String?

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([teamId, personId])
}

model TeamConvocation {
  id String @id @default(uuid())

  teamId    String
  createdBy String

  note String?

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  creator Person @relation(fields: [createdBy], references: [id])

  members TeamConvocationMember[]
}

model TeamConvocationMember {
  id String @id @default(uuid())

  convocationId String
  personId      String

  createdAt DateTime @default(now())

  convocation TeamConvocation @relation(fields: [convocationId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([convocationId, personId])
}

model EditionTeam {
  id String @id @default(uuid())

  editionId String
  teamId    String?

  name String

  groupName String?

  enrolledBy String?

  createdAt DateTime @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  team Team? @relation(fields: [teamId], references: [id])

  enrolledByPerson Person? @relation(fields: [enrolledBy], references: [id])

  players EditionTeamPlayer[]
  staff   EditionTeamStaff[]

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")

  events MatchEvent[]

  @@unique([editionId, teamId])
}

model EditionTeamPlayer {
  id String @id @default(uuid())

  editionTeamId String
  personId      String

  shirtNumber Int?
  position    String?

  createdAt DateTime @default(now())

  editionTeam EditionTeam @relation(fields: [editionTeamId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([editionTeamId, personId])
}

model EditionTeamStaff {
  id String @id @default(uuid())

  editionTeamId String
  personId     String

  role StaffRole

  createdAt DateTime @default(now())

  editionTeam EditionTeam @relation(fields: [editionTeamId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([editionTeamId, personId, role])
}

model Round {
  id String @id @default(uuid())

  editionId String

  name String

  order Int

  createdAt DateTime @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  matches Match[]

  @@index([editionId, order])
}

model Match {
  id String @id @default(uuid())

  editionId String
  roundId   String

  homeEditionTeamId String?
  awayEditionTeamId String?

  date DateTime?

  location String?

  status MatchStatus @default(SCHEDULED)

  homeScore Int @default(0)
  awayScore Int @default(0)

  parentHomeMatchId String?
  parentAwayMatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  homeTeam EditionTeam? @relation("HomeTeam", fields: [homeEditionTeamId], references: [id])

  awayTeam EditionTeam? @relation("AwayTeam", fields: [awayEditionTeamId], references: [id])

  parentHomeMatch Match? @relation("ParentHome", fields: [parentHomeMatchId], references: [id])

  parentAwayMatch Match? @relation("ParentAway", fields: [parentAwayMatchId], references: [id])

  childHomeMatches Match[] @relation("ParentHome")

  childAwayMatches Match[] @relation("ParentAway")

  referees MatchReferee[]

  events MatchEvent[]

  @@index([editionId])
  @@index([roundId])
  @@index([date])
}

model MatchReferee {
  id String @id @default(uuid())

  matchId  String
  personId String

  role RefereeRole

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([matchId, personId])
  @@unique([matchId, role])
}

model MatchEvent {
  id String @id @default(uuid())

  matchId String

  personId String?

  editionTeamId String

  type EventType

  minute Int

  extraMinute Int @default(0)

  createdBy String?

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  person Person? @relation(fields: [personId], references: [id])

  editionTeam EditionTeam @relation(fields: [editionTeamId], references: [id], onDelete: Cascade)

  creator Person? @relation("MatchEventCreatedBy", fields: [createdBy], references: [id])

  @@index([matchId, minute, extraMinute])
}

model OfficialCertification {
  id String @id @default(uuid())

  editionId String
  personId  String

  pricePaid Decimal

  certifiedAt DateTime?

  status CertStatus @default(PENDING)

  createdAt DateTime @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  person Person @relation(fields: [personId], references: [id])
}
